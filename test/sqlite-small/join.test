statement ok
create table probe (x integer not null, y varchar(10) not null);

statement ok
insert into probe values (7,'k7'), (42,'k42'), (99,'k99');

query tsv rowsort
select probe.x, pk2.v from probe, pk2 where probe.x = pk2.b and probe.y = pk2.a
----
42	420
7	70
99	990

