# Comparisons of float8 / float4 columns with constants in a selection on a
# base table. They are pushed into the scan, whose restrictions had no filter
# for floats (`RUNTIME: unsupported type in filterdouble`). The constant comes
# as text ("0.5") or as an integer; also with NULLs and the constant on the left.

statement ok
create table f(k integer not null, a float8, b float4, primary key (k));

statement ok
insert into f values (1, 0.25, 0.25), (2, 0.5, 0.5), (3, 0.75, 0.75), (4, null, null), (5, 2.0, 2.0), (6, 0.1, 0.1);

query T rowsort
select k from f where a > 0.5
----
3
5

query T rowsort
select k from f where a = 0.5
----
2

query T rowsort
select k from f where a <> 0.5
----
1
3
5
6

query T rowsort
select k from f where a <= 2
----
1
2
3
5
6

query T rowsort
select k from f where 0.5 > a
----
1
6

query T rowsort
select k from f where a = 0.1
----
6

query T rowsort
select k from f where a between 0.25 and 0.75
----
1
2
3

query T rowsort
select k from f where a in (0.25, 2.0)
----
1
5

query T rowsort
select k from f where b >= 0.75
----
3
5

query T rowsort
select k from f where b < 1
----
1
2
3
6

query T rowsort
select k from f where b = 0.1
----
6

query T rowsort
select k from f where b <> 0.5
----
1
3
5
6
