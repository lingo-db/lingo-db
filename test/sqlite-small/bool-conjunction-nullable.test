# AND / OR of a NOT NULL and a nullable bool column in the select list: the
# result is nullable (three-valued logic).

statement ok
create table flags(k integer not null, a bool not null, b bool, primary key (k));

statement ok
insert into flags values (1, true, false), (2, true, null), (3, false, null), (4, true, true);

query T rowsort
select k, a and b, a or b from flags
