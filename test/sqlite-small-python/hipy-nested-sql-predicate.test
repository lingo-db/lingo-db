# A hipy UDF with nested SQL inside a loop (evaluated in place, per
# iteration) used in a WHERE predicate, of a selection and of a join. The
# predicate's ops used to be cloned during RelAlgToSubOp, so the nested
# operators were never converted ("failed to legalize operation
# 'relalg.basetable'", or unresolved columns of the nested query in a join).
# Without a loop, the nested query is extracted and the predicate is fine.

statement ok
create table t(x int8 not null, y int8 not null);

statement ok
insert into t values (1, 10), (2, 20), (3, 30);

statement ok
CREATE OR REPLACE FUNCTION ysum(a INT8, n INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def ysum(a, n):
    s = 0
    for i in range(n):
        s += sql.execute(sql.nullable(int), "SELECT t.y FROM t WHERE t.x = PARAM(1)", a).get_value()
    return s
$$ LANGUAGE hipy;

query tsv rowsort 1
select x from t where ysum(x, 2) > 30;
----
2
3

# combined with another condition (AND)
query tsv rowsort 2
select x from t where x < 3 and ysum(x, 3) >= 30;
----
1
2

# in a join predicate
query tsv rowsort 3
select a.x, b.x from t a, t b where ysum(a.x, b.x) > 40;
----
2	3
3	2
3	3

query tsv nosort 4
select count(*) from t where ysum(x, 0) = 0;
----
3
