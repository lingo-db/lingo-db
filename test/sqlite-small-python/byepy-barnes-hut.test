CREATE OR REPLACE FUNCTION force(body_x FLOAT8, body_y FLOAT8, body_mass FLOAT8, theta FLOAT8) RETURNS TEXT AS $$
# ByePy "Barnes-Hut" example (vendored/byepy-examples/barnes_hut/barnes_hut.py),
# adapted to LANGUAGE hipy. Copyright (C) 2022 Tim Fischer, GPLv3 (see
# vendored/byepy-examples/LICENSE). See docs/byepy-barnes-hut.md.
#
# Used with `CREATE FUNCTION force(body_x FLOAT8, body_y FLOAT8, body_mass FLOAT8,
# theta FLOAT8) RETURNS TEXT AS $$ ... $$ LANGUAGE hipy` on the tables of
# instance.py (walls(x1, y1, x2, y2), barneshut). Changes to the original:
# - SQL(query, [args])        -> sql.execute(<type>, query, *args), $n -> PARAM(n)
# - @dataclass composites     -> module-level namedtuples; body passed as 3 floats
# - SELECT b / array_agg(b)   -> the columns; sql.row(...) / sql.rows(...) and
#                                Barneshut(*row)
# - walls line, pos <= pos ## w.wall (a point <= stock PostgreSQL lacks, D3)
#                             -> the side of the line through (x1, y1), (x2, y2)
# - FROM (...) AS _(pos, center) -> AS t(pos_x, pos_y, center_x, center_y)
#                                (points flattened; `_` is no alias in LingoDB, S2)
# - -> Vec2f                  -> repr(Vec2f(fx, fy)), RETURNS TEXT
import hipy
import hipy.lib.sql as sql
import hipy.lib.collections
import hipy.lib.math
from collections import namedtuple
from math import sqrt

Bodies = namedtuple("Bodies", ["x", "y", "mass"])
Barneshut = namedtuple("Barneshut", ["node", "parent", "mass", "size", "x", "y"])
Vec2f = namedtuple("Vec2f", ["x", "y"])


@hipy.compiled_function
def force(body_x, body_y, body_mass, theta):
    body = Bodies(body_x, body_y, body_mass)
    G = 6.67e-11
    node = Barneshut(*sql.execute(sql.row(sql.nullable(int), sql.nullable(int), float, float, float, float), """
        SELECT b.node, b.parent, b.mass, b.size, b.x, b.y
        FROM   barneshut AS b
        WHERE  node = 0
        """))
    Q = [node]
    fx = 0.0
    fy = 0.0

    while len(Q) > 0:
        node = Q.pop()
        dist = max(
            sqrt((node.x - body.x) ** 2 + (node.y - body.y) ** 2),
            1e-10,
        )

        if node.node is None or node.size / dist < theta:
            if sql.execute(bool, """
              SELECT NOT EXISTS (
                  SELECT 1
                  FROM walls AS w
                  WHERE ((w.x2 - w.x1) * (t.pos_y    - w.y1) - (w.y2 - w.y1) * (t.pos_x    - w.x1) <= 0)
                     <> ((w.x2 - w.x1) * (t.center_y - w.y1) - (w.y2 - w.y1) * (t.center_x - w.x1) <= 0))
              FROM (SELECT PARAM(1), PARAM(2), PARAM(3), PARAM(4)) AS t(pos_x, pos_y, center_x, center_y)
              """, body.x, body.y, node.x, node.y):
                fac = G * body.mass * node.mass / (dist ** 2)
                fx += (node.x - body.x) * fac
                fy += (node.y - body.y) * fac
        else:
            Q.extend([Barneshut(*r) for r in sql.execute(sql.rows(sql.nullable(int), sql.nullable(int), float, float, float, float), """
                    SELECT b.node, b.parent, b.mass, b.size, b.x, b.y
                    FROM   barneshut AS b
                    WHERE  b.parent = PARAM(1)
                    """, node.node)])

    return repr(Vec2f(fx, fy))
$$ LANGUAGE hipy;

# single bodies (the second one exactly on the end point of wall 1)
query T
select force(500.0, 500.0, 1.0, 0.5)
----
Vec2f(x=7.717304857211697e-12, y=-5.284158332045279e-12)

query T
select force(275.02931836911927, 223.21073814882274, 2.5, 0.5)
----
Vec2f(x=-4.527294656101045e-11, y=6.589243861742571e-11)

query T
select force(10.5, 990.25, 7.0, 0.5)
----
Vec2f(x=1.8782155303719068e-11, y=-1.073390577795497e-10)

