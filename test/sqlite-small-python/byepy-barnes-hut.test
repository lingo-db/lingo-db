# The ByePy "Barnes-Hut" example (vendored/byepy-examples/barnes_hut) as a hipy
# UDF: the force on a body from the quad-tree barneshut, nodes hidden by a wall
# not counted; a depth-first traversal with a list as stack (list.pop,
# list.extend with the children from list-valued nested SQL, sql.rows), and
# the wall test as NOT EXISTS in nested SQL in the loop, on a derived table of
# PARAMs. Source: docs/byepy-barnes-hut/barnes_hut.py (adaptations listed
# there). Data: docs/byepy-barnes-hut/instance.py with N = 100 bodies (a tree of
# 170 rows), W = 3 walls, 100 driver bodies (seed 42; the first
# ones lie exactly on a body and on the end points of wall 1). Expected values:
# instance.py ref (CPython, the original force() on the same tables).

statement ok
create table walls(x1 float8 not null, y1 float8 not null, x2 float8 not null, y2 float8 not null)

