create function profitable_manager(manager varchar, yr int8)
    returns int8
    language hipy
as
$$
import hipy
import hipy.lib.sql as sql

@hipy.compiled_function
def profitable_manager(manager, yr):
    net_profit = 0.0

    r = sql.execute(
        sql.nullable(float),
        "SELECT SUM(ss_net_profit)::float "
        "FROM store, store_sales, date_dim "
        "WHERE ss_sold_date_sk = d_date_sk "
        "  AND d_year = PARAM(2) "
        "  AND s_manager = PARAM(1) "
        "  AND s_store_sk = ss_store_sk",
        manager, yr
    )
    net_profit = r.get_value_or_default(0.0)

    if net_profit > 0:
        return 1
    else:
        return 0
$$;

