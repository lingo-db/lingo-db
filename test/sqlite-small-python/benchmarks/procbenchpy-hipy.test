create function preferred_channel_wrt_count(cust_key int8)
    returns varchar
    language hipy
as
$$
import hipy
import hipy.lib.sql as sql

@hipy.compiled_function
def preferred_channel_wrt_count(cust_key):
    num_web = 0
    num_store = 0
    num_cat = 0

    num_web = sql.execute(
        sql.nullable(int),
        "SELECT COUNT(*) "
        "FROM web_sales "
        "WHERE ws_bill_customer_sk = PARAM(1)",
        cust_key
    ).get_value_or_default(0)


    num_store = sql.execute(
        sql.nullable(int),
        "SELECT COUNT(*) "
        "FROM store_sales "
        "WHERE ss_customer_sk = PARAM(1)",
        cust_key
    ).get_value_or_default(0)


    num_cat = sql.execute(
        sql.nullable(int),
        "SELECT COUNT(*) "
        "FROM catalog_sales "
        "WHERE cs_bill_customer_sk = PARAM(1)",
        cust_key
    ).get_value_or_default(0)


    if num_web >= num_store and num_web >= num_cat:
        return 'web'
    if num_store >= num_web and num_store >= num_cat:
        return 'store'
    if num_cat >= num_store and num_cat >= num_web:
        return 'Catalog'

    return 'Logical error'
$$;

