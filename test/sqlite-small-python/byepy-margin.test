statement ok
CREATE OR REPLACE FUNCTION margin(partkey INT8) RETURNS TEXT AS $$
import hipy
import hipy.lib.sql as sql
import hipy.lib.collections
from collections import namedtuple


@hipy.compiled_function
def margin(partkey):
    DatedOrder = namedtuple("DatedOrder", ["orderkey", "orderdate"])
    Trade = namedtuple("Trade", ["buy", "sell", "margin"])

    cheapest = float('+inf')
    best_margin = float('-inf')
    # only assigned in branches inside the loop: hipy needs them declared
    # before it (always assigned in the first iteration, so never read as 0)
    cheapest_order = 0
    buy = 0
    sell = 0

    # (1) first order for the given part
    this_order = sql.execute(sql.nullable(sql.row(int, str)), "SELECT o.o_orderkey, o.o_orderdate FROM lineitem AS l, orders AS o WHERE l.l_orderkey = o.o_orderkey AND l.l_partkey = PARAM(1) ORDER BY o.o_orderdate, o.o_orderkey LIMIT 1", partkey)

    # hunt for the best margin while there are more orders to consider
    while this_order is not None:
        order = DatedOrder(*this_order.get_value())
        # (2) price of part in this order
        price = sql.execute(float, "SELECT MIN(l.l_extendedprice * (1 - l.l_discount) * (1 + l.l_tax)) FROM lineitem AS l WHERE l.l_partkey = PARAM(1) AND l.l_orderkey = PARAM(2)", partkey, order.orderkey)

        # if this is the new cheapest price, remember it
        if price <= cheapest:
            cheapest = price
            cheapest_order = order.orderkey

        # compute current obtainable margin
        profit = price - cheapest
        if profit >= best_margin:
            buy = cheapest_order
            sell = order.orderkey
            best_margin = profit

        # (3) find next order (if any) that traded the part
        this_order = sql.execute(sql.nullable(sql.row(int, str)), "SELECT o.o_orderkey, o.o_orderdate FROM lineitem AS l, orders AS o WHERE l.l_orderkey = o.o_orderkey AND l.l_partkey = PARAM(1) AND o.o_orderdate > PARAM(2) ORDER BY o.o_orderdate, o.o_orderkey LIMIT 1", partkey, order.orderdate)

    t = Trade(buy, sell, best_margin)
    return repr(t)
$$ LANGUAGE hipy;

query T
select k, margin(k) from (values (1), (2), (10)) as t(k) order by k
----
1
Trade(buy=5121, sell=29859, margin=42613.3356)
2
Trade(buy=54630, sell=4452, margin=40942.3212)
10
Trade(buy=33284, sell=45440, margin=42149.024171)

# the original driver (first 1000 parts; ORDER BY for a deterministic choice)
query T
select p_partkey, margin(p_partkey) from (select p_partkey from part order by p_partkey limit 1000) as p order by p_partkey
----
1
Trade(buy=5121, sell=29859, margin=42613.3356)
2
Trade(buy=54630, sell=4452, margin=40942.3212)
3
Trade(buy=32932, sell=30021, margin=35379.54)
4
Trade(buy=9347, sell=13698, margin=41666.264)
5
Trade(buy=20835, sell=7907, margin=42278.523)
10
Trade(buy=33284, sell=45440, margin=42149.024171)
