# ByePy "TPC-H Margins" example (vendored/byepy-examples/margin/margin.py, see
# docs/byepy-margin.md), adapted to LANGUAGE hipy (docs/byepy-margin/margin.py,
# inlined below): walks through the orders of a part in date order (a
# `while this_order is not None` loop over an optional row, two nested queries
# per iteration, one of them a join with ORDER BY ... LIMIT 1) and finds the
# best buy/sell pair. cheapest_order, buy and sell are declared before the
# loop (in the original they are only assigned in branches inside it; hipy
# can't carry such variables, M2 in docs/byepy-margin.md).
# Records are namedtuples defined in the function; the Trade result is
# returned as its repr (= the original's dataclass repr, RETURNS TEXT).
# Date ties are broken by o_orderkey (the original's ORDER BY o_orderdate
# alone is nondeterministic; parts 1 and 10 have ties, and the tie-break
# changes part 1's result). Part 2 occurs twice in one order (MIN).
# Data: the TPC-H sf0.01 rows of parts 1-5 and 10, all their lineitems, the
# orders of these lineitems and one more lineitem (of another part) per order
# (real TPC-H column types). Expected values from the original algorithm in
# CPython (docs/byepy-margin/reference.py; same as on the full sf0.01 data).
# A part without orders is not tested: the original raises UnboundLocalError.
# Nested SQL strings stay on one line each.

statement ok
create table part(p_partkey integer not null, p_name varchar(55) not null, p_mfgr char(25) not null, p_brand char(10) not null, p_type varchar(25) not null, p_size integer not null, p_container char(10) not null, p_retailprice decimal(12, 2) not null, p_comment varchar(23) not null, primary key (p_partkey));

statement ok
create table orders(o_orderkey integer not null, o_custkey integer not null, o_orderstatus char(1) not null, o_totalprice decimal(12, 2) not null, o_orderdate date not null, o_orderpriority char(15) not null, o_clerk char(15) not null, o_shippriority integer not null, o_comment varchar(79) not null, primary key (o_orderkey));

statement ok
create table lineitem(l_orderkey integer not null, l_partkey integer not null, l_suppkey integer not null, l_linenumber integer not null, l_quantity decimal(12, 2) not null, l_extendedprice decimal(12, 2) not null, l_discount decimal(12, 2) not null, l_tax decimal(12, 2) not null, l_returnflag char(1) not null, l_linestatus char(1) not null, l_shipdate date not null, l_commitdate date not null, l_receiptdate date not null, l_shipinstruct char(25) not null, l_shipmode char(10) not null, l_comment varchar(44) not null, primary key (l_orderkey, l_linenumber));

statement ok
insert into part values (1, 'goldenrod lavender spring chocolate lace', 'Manufacturer#1', 'Brand#13', 'PROMO BURNISHED COPPER', 7, 'JUMBO PKG', 901.00, 'ly. slyly ironi'), (2, 'blush thistle blue yellow saddle', 'Manufacturer#1', 'Brand#13', 'LARGE BRUSHED BRASS', 1, 'LG CASE', 902.00, 'lar accounts amo'), (3, 'spring green yellow purple cornsilk', 'Manufacturer#4', 'Brand#42', 'STANDARD POLISHED BRASS', 21, 'WRAP CASE', 903.00, 'egular deposits hag'), (4, 'cornflower chocolate smoke green pink', 'Manufacturer#3', 'Brand#34', 'SMALL PLATED BRASS', 14, 'MED DRUM', 904.00, 'p furiously r'), (5, 'forest brown coral puff cream', 'Manufacturer#3', 'Brand#32', 'STANDARD POLISHED TIN', 15, 'SM PKG', 905.00, ' wake carefully '), (10, 'linen pink saddle puff powder', 'Manufacturer#5', 'Brand#54', 'LARGE BURNISHED STEEL', 44, 'LG CAN', 910.01, 'ithely final deposit');

