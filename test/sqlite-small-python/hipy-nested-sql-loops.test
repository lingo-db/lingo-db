statement ok
CREATE OR REPLACE FUNCTION aggr(x INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def aggr(x):
    acc = 0
    for i in range(x):
        acc += sql.execute(sql.nullable(int), "SELECT count(*) FROM kv WHERE k < PARAM(1)", i).get_value()
        acc += sql.execute(sql.nullable(int), "SELECT sum(v) FROM kv WHERE k <= PARAM(1)", i).get_value_or_default(0)
    return acc
$$ LANGUAGE hipy;

query tsv rowsort 8
select aggr(3);
----
67

