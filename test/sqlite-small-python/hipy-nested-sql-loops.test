CREATE OR REPLACE FUNCTION ifinloop(x INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def ifinloop(x):
    acc = 0
    for i in range(x):
        if i % 2 == 0:
            acc += sql.execute(sql.nullable(int), "SELECT v FROM kv WHERE k = PARAM(1)", i).get_value()
    return acc
$$ LANGUAGE hipy;

