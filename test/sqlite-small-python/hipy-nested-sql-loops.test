CREATE OR REPLACE FUNCTION w(x INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def w(x):
    i = 0
    acc = 0
    while i < x:
        acc += sql.execute(sql.nullable(int), "SELECT v FROM kv WHERE k = PARAM(1)", i).get_value()
        i += 1
    return acc
$$ LANGUAGE hipy;

query tsv rowsort 2
select w(3);
----
33

