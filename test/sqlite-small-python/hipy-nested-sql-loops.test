CREATE OR REPLACE FUNCTION nested(x INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def nested(x):
    acc = 0
    for i in range(x):
        for j in range(x):
            acc += sql.execute(sql.nullable(int), "SELECT v FROM kv WHERE k = PARAM(1)", i + j).get_value()
    return acc
$$ LANGUAGE hipy;

