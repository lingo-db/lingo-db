CREATE OR REPLACE FUNCTION strs(x INT8) RETURNS TEXT AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def strs(x):
    res = ""
    for i in range(x):
        res = res + sql.execute(sql.nullable(str), "SELECT s FROM kv WHERE k = PARAM(1)", x - 1 - i).get_value()
    return res
$$ LANGUAGE hipy;

query tsv rowsort 4
select strs(4);
----
dcba

