import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def fromlist(x):
    keys = [5, 3, 1]
    acc = 0
    for i in range(x):
        acc = acc * 100 + sql.execute(sql.nullable(int), "SELECT v FROM kv WHERE k = PARAM(1)", keys[i]).get_value()
    return acc
$$ LANGUAGE hipy;

