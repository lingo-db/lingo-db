CREATE OR REPLACE FUNCTION nullcase(x INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def nullcase(x):
    misses = 0
    for i in range(x):
        if sql.execute(sql.nullable(int), "SELECT v FROM kv WHERE k = PARAM(1)", i + 4).is_null():
            misses += 1
    return misses
$$ LANGUAGE hipy;

query tsv rowsort 3
select nullcase(5);
----
3

