import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def twoparams(x):
    acc = 0
    for i in range(x):
        acc += sql.execute(sql.nullable(int), "SELECT count(*) FROM kv WHERE k >= PARAM(1) AND v <= PARAM(2)", i, x + 10).get_value()
    return acc
$$ LANGUAGE hipy;

