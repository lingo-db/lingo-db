# Nested SQL (hipy.lib.sql.execute) inside loops of LANGUAGE hipy UDFs. The
# subqueries depend on loop-carried values, so they stay inside the loop and
# are evaluated per iteration (ExtractNestedOperators / ImplicitToExplicitJoins
# leave them in place; they are lowered to a nested execution group inside the
# loop). Covers for/while loops, conditionals in/around loops, nested loops,
# NULL (no row), string results, aggregates, loop-invariant queries,
# parameters read from a list, multiple parameters, and many concurrent UDF
# invocations. Nested SQL strings stay on one line each.

statement ok
create table program(loc int8, opc text, reg1 int8, reg2 int8, reg3 int8);

statement ok
insert into program values (0,'lod',1,5,0),(1,'add',1,1,1),(2,'jeq',1,1,4),(3,'jmp',0,0,0),(4,'hlt',1,0,0);

statement ok
CREATE OR REPLACE FUNCTION f(x INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def f(x):
    acc = 0
    for i in range(x):
        acc += sql.execute(sql.nullable(int), "SELECT reg1 FROM program WHERE loc = PARAM(1)", i).get_value()
    return acc
$$ LANGUAGE hipy;

query tsv rowsort 1
select f(3);
----
3

