# Joins in nested queries inside loops: the hash-join probe is a
# subop.nested_map whose consumers (the aggregation) get inlined into it
# (InlineNestedMapPass hoists the aggregation state before it).
statement ok
create table li(o int8, p int8);

statement ok
insert into li values (1,10),(1,20),(2,10),(3,30);

statement ok
create table part(pk int8, sz int8);

statement ok
insert into part values (10,3),(20,5),(30,7);

statement ok
CREATE OR REPLACE FUNCTION joinfor(n INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def joinfor(n):
    s = 0
    for o in range(n):
        s += sql.execute(sql.nullable(int), "SELECT COUNT(*) FROM li, part WHERE li.o = PARAM(1) AND li.p = part.pk", o + 1).get_value()
    return s
$$ LANGUAGE hipy;

query tsv rowsort 13
select joinfor(3);
----
4

statement ok
CREATE OR REPLACE FUNCTION joinwhile(o INT8) RETURNS INT8 AS $$
import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def joinwhile(o):
    s = 0
    i = 0
    while i < o:
        r = sql.execute(sql.nullable(int), "SELECT SUM(part.sz) FROM li, part WHERE li.o = PARAM(1) AND li.p = part.pk", i)
        if not r.is_null():
            s += r.get_value()
        i += 1
    return s
$$ LANGUAGE hipy;

query tsv rowsort 14
select o, joinwhile(o) from li;
----
1	0
1	0
2	8
3	11
