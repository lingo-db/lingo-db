# The ByePy "Markov Robot" example (vendored/byepy-examples/markov,
# docs/byepy-markov.md): a robot walks on a 10x10 grid following a policy; per
# step, three nested queries (the policy's action, the reached state among the
# action's outcomes via a random roll and cumulative probabilities from two
# window functions, its reward).
# Instance: docs/byepy-markov/instance.py 42 (the original's PostgreSQL setup
# replicated in Python: 90 states, rewards in {-2, -1, 0, 1}, 1053 actions,
# policy after policy iteration).
# walk: the adapted source (docs/byepy-markov/markov.py) with random() as in the
# original, so only properties are checked: |reward| <= 2 per step, so a
# failure (<= -8) takes >= 4 steps and a success (>= 8) >= 8 steps; the result
# is 0 or (+/-) the step count.
# walk_det: the same with a deterministic roll instead of random()
# (float((start_state * 7919 + step * 104729) * 2654435761 % 4294967296) /
# 4294967296.0); expected values from docs/byepy-markov/reference.py.

statement ok
create table states(id int4 primary key, name text, r float8);

statement ok
create table actions(id int4 primary key, name text, s_from int4, s_to int4, p float8);

statement ok
create table policy(state_id int4, action_name text);

