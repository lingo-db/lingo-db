create table robots(id int4 not null);

# the original driver's 10 random start positions (drawn once with Python's
# random.Random(42)), as a table
statement ok
insert into robots values (64), (4), (28), (23), (76), (68), (90), (9), (41), (4);

statement ok
CREATE OR REPLACE FUNCTION walk(start_state INT8, success_at INT8, failure_at INT8, max_steps INT8) RETURNS INT8 AS $$
# ByePy "Markov Robot" example (vendored/byepy-examples/markov/markov.py),
# function `walk`, adapted to LANGUAGE hipy. Copyright (C) 2022 Tim Fischer,
# GPLv3 (see vendored/byepy-examples/LICENSE). See docs/byepy-markov.md.
#
# Changes to the original (syntax only):
# - SQL(query, [args])           -> sql.execute(<type>, query, *args)
# - $1, $2, $3                   -> PARAM(1), PARAM(2), PARAM(3)
# - typed results                -> sql.nullable(...) + .get_value()
# - type annotations dropped       (hipy infers types; arguments are INT8)
# - nested SQL strings on one line each, like the other hipy tests
# - `import hipy.lib.math` / `import hipy.lib.random` (hipy's versions of the
#   modules are only used when imported, like hipy.lib.sql)
# Kept as in the original: `random()`, `copysign`, `round`, the window
# functions, `return` inside the loop.
import hipy
import hipy.lib.sql as sql
import hipy.lib.math
import hipy.lib.random
from random import random
from math import copysign


@hipy.compiled_function
def walk(start_state, success_at, failure_at, max_steps):
    total_reward = 0.0
    curr_state = start_state
    curr_action = ''

    for step in range(1, max_steps + 1):
        # Find the action the policy finds appropriate in
        # the current state
        curr_action = sql.execute(sql.nullable(str), "SELECT p.action_name FROM policy AS p, states AS s WHERE PARAM(1) = s.id AND p.state_id = s.id", curr_state).get_value()

        # Random numer roll in [0.0, 1.0)
        roll = random()

        # Find the state we actually reach. There may be a
        # chance we end up in another state.
        curr_state = sql.execute(sql.nullable(int), "SELECT possible_moves.s_to FROM (SELECT a.s_to, coalesce(sum(a.p) OVER (ORDER BY a.id ROWS BETWEEN unbounded preceding AND 1 preceding), 0.0) AS p_from, sum(a.p) OVER (ORDER BY a.id) AS p_to FROM actions AS a WHERE PARAM(1) = a.s_from AND PARAM(2) = a.name) AS possible_moves(s_to, p_from, p_to) WHERE possible_moves.p_from <= PARAM(3) AND possible_moves.p_to > PARAM(3)", curr_state, curr_action, roll).get_value()

        # Add the reward we receive by stepping on the state
        # we actually reached
        total_reward += sql.execute(sql.nullable(float), "SELECT s.r FROM states AS s WHERE PARAM(1) = s.id", curr_state).get_value()

        if total_reward >= success_at or total_reward <= failure_at:
            return round(step * copysign(1, total_reward))

    return 0
$$ LANGUAGE hipy;

statement ok
CREATE OR REPLACE FUNCTION walk_det(start_state INT8, success_at INT8, failure_at INT8, max_steps INT8) RETURNS INT8 AS $$
# ByePy "Markov Robot" example (vendored/byepy-examples/markov/markov.py),
# function `walk`, adapted to LANGUAGE hipy. Copyright (C) 2022 Tim Fischer,
# GPLv3 (see vendored/byepy-examples/LICENSE). See docs/byepy-markov.md.
#
# Changes to the original (syntax only):
# - SQL(query, [args])           -> sql.execute(<type>, query, *args)
# - $1, $2, $3                   -> PARAM(1), PARAM(2), PARAM(3)
# - typed results                -> sql.nullable(...) + .get_value()
# - type annotations dropped       (hipy infers types; arguments are INT8)
# - nested SQL strings on one line each, like the other hipy tests
# - `import hipy.lib.math` / `import hipy.lib.random` (hipy's versions of the
#   modules are only used when imported, like hipy.lib.sql)
# Kept as in the original: `random()`, `copysign`, `round`, the window
# functions, `return` inside the loop.
import hipy
import hipy.lib.sql as sql
import hipy.lib.math
import hipy.lib.random
from random import random
from math import copysign


@hipy.compiled_function
def walk_det(start_state, success_at, failure_at, max_steps):
    total_reward = 0.0
    curr_state = start_state
    curr_action = ''

    for step in range(1, max_steps + 1):
        # Find the action the policy finds appropriate in
        # the current state
        curr_action = sql.execute(sql.nullable(str), "SELECT p.action_name FROM policy AS p, states AS s WHERE PARAM(1) = s.id AND p.state_id = s.id", curr_state).get_value()

        # Random numer roll in [0.0, 1.0)
        roll = float((start_state * 7919 + step * 104729) * 2654435761 % 4294967296) / 4294967296.0

        # Find the state we actually reach. There may be a
        # chance we end up in another state.
        curr_state = sql.execute(sql.nullable(int), "SELECT possible_moves.s_to FROM (SELECT a.s_to, coalesce(sum(a.p) OVER (ORDER BY a.id ROWS BETWEEN unbounded preceding AND 1 preceding), 0.0) AS p_from, sum(a.p) OVER (ORDER BY a.id) AS p_to FROM actions AS a WHERE PARAM(1) = a.s_from AND PARAM(2) = a.name) AS possible_moves(s_to, p_from, p_to) WHERE possible_moves.p_from <= PARAM(3) AND possible_moves.p_to > PARAM(3)", curr_state, curr_action, roll).get_value()

        # Add the reward we receive by stepping on the state
        # we actually reached
        total_reward += sql.execute(sql.nullable(float), "SELECT s.r FROM states AS s WHERE PARAM(1) = s.id", curr_state).get_value()

        if total_reward >= success_at or total_reward <= failure_at:
            return round(step * copysign(1, total_reward))

    return 0
$$ LANGUAGE hipy;

# the original driver: SUCCESS_AT = 8, FAILURE_AT = -8, MAX_STEPS = 10
query tsv nosort 1
select count(*) from (select walk(id, 8, -8, 10) as w from robots) s where w = 0 or (w >= 8 and w <= 10) or (w >= -10 and w <= -4);
----
10

# every state as start state
query tsv nosort 2
select count(*) from (select walk(id, 8, -8, 10) as w from states) s where w = 0 or (w >= 8 and w <= 10) or (w >= -10 and w <= -4);
----
90

# thresholds out of reach
query tsv nosort 3
select count(*) from states where walk(id, 1000, -1000, 10) = 0;
----
90

