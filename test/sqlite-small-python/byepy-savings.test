statement ok
CREATE OR REPLACE FUNCTION savings(orderkey INT8) RETURNS TEXT AS $$
import hipy
import hipy.lib.sql as sql


@hipy.compiled_function
def savings(orderkey):
    # o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate,
    # o_orderpriority, o_clerk, o_shippriority, o_comment
    order = sql.execute(sql.nullable(sql.row(int, int, str, float, str, str, str, int, str)), "SELECT o.* FROM orders AS o WHERE o.o_orderkey = PARAM(1)", orderkey)

    if order is None:
        return None

    items = sql.execute(int, "SELECT COUNT(*) FROM lineitem AS l WHERE l.l_orderkey = PARAM(1)", orderkey)
    total_supplycost = 0.0
    new_supplycost = 0.0
    new_suppliers = []

    for item in range(1, items + 1):
        # l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity,
        # l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus,
        # l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode,
        # l_comment
        lineitem = sql.execute(sql.row(int, int, int, int, float, float, float, float, str, str, str, str, str, str, str, str), "SELECT l.* FROM lineitem AS l WHERE l.l_orderkey = PARAM(1) AND l.l_linenumber = PARAM(2)", orderkey, item)
        l_partkey = lineitem[1]
        l_suppkey = lineitem[2]
        l_quantity = lineitem[4]
        # ps_partkey, ps_suppkey, ps_availqty, ps_supplycost, ps_comment
        partsupp = sql.execute(sql.row(int, int, int, float, str), "SELECT ps.* FROM partsupp AS ps WHERE PARAM(1) = ps.ps_partkey AND PARAM(2) = ps.ps_suppkey", l_partkey, l_suppkey)
        ps_suppkey = partsupp[1]
        ps_supplycost = partsupp[3]
        min_supplycost = sql.execute(float, "SELECT min(ps.ps_supplycost) FROM partsupp AS ps WHERE ps.ps_partkey = PARAM(1) AND ps.ps_availqty >= PARAM(2)", l_partkey, l_quantity)
        new_supplier = sql.execute(int, "SELECT min(ps.ps_suppkey) FROM partsupp AS ps WHERE ps.ps_supplycost = PARAM(1) AND ps.ps_partkey = PARAM(2)", min_supplycost, l_partkey)

        if new_supplier != ps_suppkey:
            new_suppliers.append((l_partkey, ps_suppkey, new_supplier))

        total_supplycost += ps_supplycost * l_quantity
        new_supplycost += min_supplycost * l_quantity

    return repr(((1 - new_supplycost / total_supplycost) * 100.0, new_suppliers))
$$ LANGUAGE hipy;

# all orders; 8 and -5 are unknown order keys
query T
select k, savings(k) from (values (1), (2), (3), (4), (5), (6), (7), (8), (-5)) as t(k) order by k
----
