# ByePy "TPC-H Savings" example (vendored/byepy-examples/savings/savings.py,
# see docs/byepy-savings.md), adapted to LANGUAGE hipy
# (docs/byepy-savings/savings.py, inlined below): re-chooses the supplier of
# every lineitem of an order so that the supply cost is minimal; four nested
# queries per lineitem inside a loop, whole-row fetches (`SELECT l.*` into
# sql.row(...)), an optional row for the order (sql.nullable(sql.row(...)) +
# `is None`), `return None` for an unknown order key (SQL NULL),
# non-nullable sql.execute(int/float, ...) results. The (savings, changes)
# result is returned as its Python repr (RETURNS TEXT).
# Data: the TPC-H sf0.01 rows of orders 1-7, their lineitems and the partsupp
# rows of their parts (real TPC-H column types: decimal columns read as
# float, a decimal column compared with a float parameter, dates read as
# str). Expected values from the original algorithm in CPython
# (docs/byepy-savings/reference.py), except that hipy prints the float 0.0
# as 0 (order 2: `(0, [])`; docs/future-work.md).
# Nested SQL strings stay on one line each.

statement ok
create table orders(o_orderkey integer not null, o_custkey integer not null, o_orderstatus char(1) not null, o_totalprice decimal(12, 2) not null, o_orderdate date not null, o_orderpriority char(15) not null, o_clerk char(15) not null, o_shippriority integer not null, o_comment varchar(79) not null, primary key (o_orderkey));

