# the original driver (first 500 open orders; ORDER BY for a deterministic choice)
query T
select o_orderkey, savings(o_orderkey) from (select o_orderkey from orders where o_orderstatus = 'O' order by o_orderkey limit 500) as o order by o_orderkey
