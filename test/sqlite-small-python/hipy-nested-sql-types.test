import hipy
import hipy.lib.sql as sql
@hipy.compiled_function
def dec(x):
    return sql.execute(sql.nullable(float), "SELECT d FROM t4 WHERE k = PARAM(1)", x).get_value()
$$ LANGUAGE hipy;

query tsv rowsort 5
