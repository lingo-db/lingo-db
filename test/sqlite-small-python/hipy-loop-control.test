CREATE OR REPLACE FUNCTION ret_for(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def ret_for(x):
    for i in range(100):
        if i * i > x:
            return i
    return -1
$$ LANGUAGE hipy;

