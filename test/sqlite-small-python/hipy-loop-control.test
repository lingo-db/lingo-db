CREATE OR REPLACE FUNCTION cont_elif(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def cont_elif(x):
    acc = 0
    for i in range(x):
        if i % 3 == 0:
            acc += 1
        elif i % 3 == 1:
            continue
        else:
            acc += 100
        acc += 10
    return acc
$$ LANGUAGE hipy;

query tsv rowsort 101
select cont_elif(7);
----
253

query tsv rowsort 102
select cont_elif(0);
----
0

statement ok
CREATE OR REPLACE FUNCTION break_elif(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def break_elif(x):
    acc = 0
    i = 0
    while i < 100:
        if i == x:
            break
        elif i % 2 == 0:
            acc += i
        else:
            acc -= 1
        i += 1
    return acc * 1000 + i
$$ LANGUAGE hipy;

query tsv rowsort 103
select break_elif(9);
----
16009

query tsv rowsort 104
select break_elif(150);
----
2400100

