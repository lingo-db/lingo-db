CREATE OR REPLACE FUNCTION ret_nested(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def ret_nested(x):
    for i in range(10):
        j = 0
        while j < 10:
            if i * j == x:
                return i * 100 + j
            j += 1
    return -1
$$ LANGUAGE hipy;

query tsv rowsort 7
select ret_nested(12);
----
206

query tsv rowsort 8
select ret_nested(0);
----
0

query tsv rowsort 9
select ret_nested(97);
----
-1

