CREATE OR REPLACE FUNCTION only_return(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def only_return(x):
    i = 0
    acc = 1
    while True:
        acc = acc * 2
        i += 1
        if acc > x:
            return i
$$ LANGUAGE hipy;

query tsv rowsort 105
select only_return(1000);
----
10

query tsv rowsort 106
select only_return(1);
----
1
