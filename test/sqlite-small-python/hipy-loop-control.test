CREATE OR REPLACE FUNCTION ret_while_true(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def ret_while_true(x):
    i = 0
    while True:
        i += 1
        if i > x:
            return i * 10
    return 0
$$ LANGUAGE hipy;

