CREATE OR REPLACE FUNCTION ret_str(x INT8) RETURNS TEXT AS $$
import hipy
@hipy.compiled_function
def ret_str(x):
    for i in range(10):
        if i == x:
            return "found" + str(i)
    return "none"
$$ LANGUAGE hipy;

