# Loop control flow in LANGUAGE hipy UDFs (rewritten on the AST by hipy before
# staging): `return` inside loops (rewrite_loop_return: value slot + flag +
# break, returned after the loop; a `while True` loop without break can only
# be left by a return), also from nested loops and with a non-trivially typed
# value, `break` out of `while` loops (the loop test must stop the loop, e.g.
# for `while True`), and break/continue nested in elif chains. Expected values
# are what CPython computes for the same function.

statement ok
CREATE OR REPLACE FUNCTION brk(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def brk(x):
    i = 0
    while True:
        i += 1
        if i > x:
            break
    return i
$$ LANGUAGE hipy;

query tsv rowsort 1
select brk(5);
----
6

query tsv rowsort 2
select brk(0);
----
1

