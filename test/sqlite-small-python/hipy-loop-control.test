CREATE OR REPLACE FUNCTION ret_after_work(x INT8) RETURNS INT8 AS $$
import hipy
@hipy.compiled_function
def ret_after_work(x):
    acc = 0
    i = 0
    while i < x:
        acc += i
        if acc > 20:
            return acc * 1000 + i
        i += 1
    return acc
$$ LANGUAGE hipy;

query tsv rowsort 12
select ret_after_work(3);
----
3

query tsv rowsort 13
select ret_after_work(100);
----
21006

query tsv rowsort 14
select ret_after_work(0);
----
0

