# ByePy "Marching Squares" example (vendored/byepy-examples/march/march.py, see
# docs/byepy-march.md), adapted to LANGUAGE hipy (docs/byepy-march/march.py,
# inlined below): from a start position, walk right until the first square
# that touches the shape, then follow its contour (marching squares) until the
# start of the contour is reached again; two row-valued nested queries per
# iteration (the 2x2 square at the current position, and the direction for
# its pattern). Module-level namedtuples (the original's dataclasses), some of
# them loop-carried, `goal = None` merged with a namedtuple, namedtuple `==`,
# a local named like the function.
# Records are flattened into columns and arguments (Vec2i -> x, y; dir ->
# dx, dy, NULL for the full square); the list[Vec2i] result is returned as
# its repr (RETURNS TEXT). dir.dir uses the checked get_value(), so the full
# square raises at runtime like the original (`None.x`).
# Data: the setup of the original (instance.py setup 20 4: a 20x20 map with
# an elliptic shape, stripe 4), only the two tables the function reads;
# expected values from the original algorithm in CPython (instance.py ref);
# the driver's starts from instance.py driver 20 4 (seed 42).
# Nested SQL strings stay on one line each.

statement ok
create table directions(ll bool not null, lr bool not null, ul bool not null, ur bool not null, dx integer, dy integer, track bool not null, primary key (ll, lr, ul, ur));

statement ok
create table squares(x integer not null, y integer not null, ll bool not null, lr bool not null, ul bool not null, ur bool not null, primary key (x, y));

