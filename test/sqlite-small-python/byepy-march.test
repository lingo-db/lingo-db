statement ok
CREATE OR REPLACE FUNCTION march(start_x INT8, start_y INT8) RETURNS TEXT AS $$
import hipy
import hipy.lib.sql as sql
import hipy.lib.collections
from collections import namedtuple

Vec2i = namedtuple("Vec2i", ["x", "y"])
Directions = namedtuple("Directions", ["ll", "lr", "ul", "ur", "dir", "track"])
Squares = namedtuple("Squares", ["xy", "ll", "lr", "ul", "ur"])


@hipy.compiled_function
def march(start_x, start_y):
    start = Vec2i(start_x, start_y)
    goal = None
    track = False
    march = []
    current = start

    while True:
        if track and current == goal:
            break

        s = sql.execute(sql.row(int, int, bool, bool, bool, bool), "SELECT s.x, s.y, s.ll, s.lr, s.ul, s.ur FROM squares AS s WHERE s.x = PARAM(1) AND s.y = PARAM(2)", current.x, current.y)
        square = Squares(Vec2i(s[0], s[1]), s[2], s[3], s[4], s[5])
        d = sql.execute(sql.row(bool, bool, bool, bool, sql.nullable(int), sql.nullable(int), bool), "SELECT d.ll, d.lr, d.ul, d.ur, d.dx, d.dy, d.track FROM directions AS d WHERE PARAM(1) = d.ll AND PARAM(2) = d.lr AND PARAM(3) = d.ul AND PARAM(4) = d.ur", square.ll, square.lr, square.ul, square.ur)
        dir = Directions(d[0], d[1], d[2], d[3], Vec2i(d[4].get_value(), d[5].get_value()), d[6])

        if not track and dir.track:
            track = True
            goal = current
        if track:
            march.append(current)

        current = Vec2i(current.x + dir.dir.x, current.y + dir.dir.y)

    return repr(march)
$$ LANGUAGE hipy;

query T
select x, y, march(x, y) from (values (0, 1), (3, 19), (2, 13)) as t(x, y) order by x, y
----
